# Example overrides for running the audio motion detector agent on a laptop.
# Copy to config/.env.laptop (ignored by git) and load it with `source` or a dotenv runner
# before invoking `make run`.

# Storage location
ORPHEUS_DATA_ROOT=/path/to/data/orpheus

# Replace the default four-channel Jetson layout with a single laptop microphone stream.
# NOTE: Must be single-line JSON - multiline breaks shell environment variable parsing
ORPHEUS_AUDIO__CHANNELS='[{"id":1,"name":"Laptop Mic","enabled":true,"device":null,"detection":{"algorithm":"adaptive_threshold","threshold_db":-30.0,"margin_db":10.0,"release_threshold_db":-35.0,"holdoff_seconds":2.0,"min_duration_seconds":0.3,"max_duration_seconds":30.0,"prebuffer_seconds":0.5,"window_seconds":30.0,"update_interval_seconds":5.0}}]'

# Lower the runtime sample rate when the built-in microphone cannot deliver 48 kHz.
ORPHEUS_AUDIO__SAMPLE_RATE=44100

# Alternative: Override individual detection parameters for existing channels
# (Uncomment to use instead of full JSON override above)
#
# ORPHEUS_AUDIO__CHANNELS__0__DETECTION__ALGORITHM=fixed_threshold
# ORPHEUS_AUDIO__CHANNELS__0__DETECTION__THRESHOLD_DB=-25.0
# ORPHEUS_AUDIO__CHANNELS__0__DETECTION__MARGIN_DB=12.0
# ORPHEUS_AUDIO__CHANNELS__0__DETECTION__HOLDOFF_SECONDS=1.5
# ORPHEUS_AUDIO__CHANNELS__0__DETECTION__MIN_DURATION_SECONDS=0.5
# ORPHEUS_AUDIO__CHANNELS__0__DETECTION__MAX_DURATION_SECONDS=20.0
# ORPHEUS_AUDIO__CHANNELS__0__DETECTION__PREBUFFER_SECONDS=0.3

# Increase log verbosity for development
ORPHEUS_LOGGING__LEVEL=DEBUG
