# Example overrides for running the audio motion detector agent on a laptop.
# Copy to config/.env.laptop (ignored by git) and load it with `source` or a dotenv runner
# before invoking `make run`. Adjust the JSON payload to match the input device exposed
# by your workstation.

ORPHEUS_DATA_ROOT=/path/to/data/orpheus

# Replace the default four-channel Jetson layout with a single laptop microphone stream.
ORPHEUS_AUDIO__CHANNELS='[{"id":1,"name":"Laptop Mic","enabled":true}]'

# Lower the runtime sample rate when the built-in microphone cannot deliver 48 kHz.
ORPHEUS_RUNTIME_SAMPLE_RATE=44100
