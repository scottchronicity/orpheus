[Unit]
Description=Orpheus Audio Motion Detector Agent
After=network.target time-sync.target orpheus-mqtt.service
Wants=orpheus-mqtt.service

[Service]
Type=simple
User=orpheus
Group=orpheus
WorkingDirectory=/opt/orpheus/agents/orpheus-agent-audio-motion
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/orpheus/agents/orpheus-agent-audio-motion/src
ExecStart=/opt/orpheus/agents/orpheus-agent-audio-motion/venv/bin/python -m orpheus_agent_audio_motion.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
