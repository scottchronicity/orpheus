[Unit]
Description=Orpheus Crow Detection Agent
After=network.target time-sync.target orpheus-backplane.service
Wants=orpheus-backplane.service

[Service]
Type=simple
User=orpheus
Group=orpheus
WorkingDirectory=/opt/orpheus/agents/orpheus-agent-crow-detection
Environment="PYTHONUNBUFFERED=1"
Environment="ORPHEUS_DATA_ROOT=/data/orpheus"
Environment="PYTHONPATH=/opt/orpheus/agents/orpheus-agent-crow-detection/src"
EnvironmentFile=-/opt/orpheus/config/.env
ExecStart=/opt/orpheus/agents/orpheus-agent-crow-detection/venv/bin/python -m orpheus_agent_crow_detection.main
Restart=on-failure
RestartSec=10
# Soft memory guardrail for the model agent (AVES + MT (torch)). MemoryHigh THROTTLES
# (reclaim pressure) rather than OOM-killing, so it never hard-fails a detector
# mid-inference; it just caps runaway growth when several model agents cold-start
# together on one host. TUNE per board: an 8GB Orin has room, a 4GB Nano wants
# lower values and/or staggered starts (see docs/runbooks/jetson-rollout.md).
# Deliberately NOT a hard MemoryMax — we never want the kernel to kill a detector.
MemoryAccounting=true
MemoryHigh=2500M
StandardOutput=journal
StandardError=journal

# Log bounds. systemd's default is 10000 messages per 30s per service — enough
# for one stuck agent to emit gigabytes a day into the journal and, on Ubuntu,
# into rsyslog's unbounded /var/log/syslog mirror. 500/30s is ~100x this
# station's busiest agent in normal operation and still passes a crash-loop
# traceback or a noisy model load intact. When the limit engages journald
# records "Suppressed N messages from <unit>", so a flood is visible as a
# flood rather than silently truncated.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
SyslogIdentifier=orpheus-crow-detection

[Install]
WantedBy=multi-user.target
