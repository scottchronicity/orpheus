[Unit]
Description=Orpheus Audio Playback Agent
# The data root is its own drive: wait for it at boot and never run without
# it, so recordings and the database cannot land on the root filesystem.
RequiresMountsFor=/data/orpheus
After=network.target time-sync.target orpheus-backplane.service
Wants=orpheus-backplane.service

[Service]
Type=simple
User=orpheus
Group=orpheus
WorkingDirectory=/opt/orpheus/agents/orpheus-agent-audio-playback
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/orpheus/agents/orpheus-agent-audio-playback/src

# Where sounds go is set by orpheus-audio-output, which installs the drop-in
# orpheus-agent-audio-playback.service.d/50-orpheus-audio-output.conf pointing
# the player at the managed audio server (PULSE_SERVER, XDG_RUNTIME_DIR, and
# SDL_AUDIODRIVER=pulseaudio). Don't derive those paths from %U here: in a
# system unit %U is the service manager's UID (0), not User=.

EnvironmentFile=-/opt/orpheus/config/.env
ExecStart=/opt/orpheus/agents/orpheus-agent-audio-playback/venv/bin/python -m orpheus_agent_audio_playback.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Log bounds. systemd's default is 10000 messages per 30s per service — enough
# for one stuck agent to emit gigabytes a day into the journal and, on Ubuntu,
# into rsyslog's unbounded /var/log/syslog mirror. 500/30s is ~100x this
# station's busiest agent in normal operation and still passes a crash-loop
# traceback or a noisy model load intact. When the limit engages journald
# records "Suppressed N messages from <unit>", so a flood is visible as a
# flood rather than silently truncated.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
# Name ourselves in syslog: without this our agents appear as "python" and an
# operator cannot tell which one is flooding.
SyslogIdentifier=orpheus-agent-audio-playback

[Install]
WantedBy=multi-user.target
