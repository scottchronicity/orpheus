[Unit]
Description=Orpheus Event Correlator Agent
After=network.target time-sync.target orpheus-backplane.service orpheus-agent-bird-detection.service orpheus-agent-crow-detection.service
Wants=orpheus-backplane.service orpheus-agent-bird-detection.service orpheus-agent-crow-detection.service

[Service]
Type=simple
User=orpheus
Group=orpheus
WorkingDirectory=/opt/orpheus/agents/orpheus-agent-event-correlator
Environment="PATH=/opt/orpheus/agents/orpheus-agent-event-correlator/venv/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONPATH=/opt/orpheus/agents/orpheus-agent-event-correlator/src"
EnvironmentFile=-/opt/orpheus/config/.env
ExecStart=/opt/orpheus/agents/orpheus-agent-event-correlator/venv/bin/python -m orpheus_agent_event_correlator.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Log bounds. systemd's default is 10000 messages per 30s per service — enough
# for one stuck agent to emit gigabytes a day into the journal and, on Ubuntu,
# into rsyslog's unbounded /var/log/syslog mirror. 500/30s is ~100x this
# station's busiest agent in normal operation and still passes a crash-loop
# traceback or a noisy model load intact. When the limit engages journald
# records "Suppressed N messages from <unit>", so a flood is visible as a
# flood rather than silently truncated.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
# Name ourselves in syslog: without this our agents appear as "python" and an
# operator cannot tell which one is flooding.
SyslogIdentifier=orpheus-agent-event-correlator

[Install]
WantedBy=multi-user.target
