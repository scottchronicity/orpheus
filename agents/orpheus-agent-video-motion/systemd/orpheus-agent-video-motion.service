[Unit]
Description=Orpheus Video Motion Detection Agent
After=network.target time-sync.target orpheus-backplane.service
Wants=orpheus-backplane.service

[Service]
Type=simple
User=orpheus
Group=orpheus
WorkingDirectory=/opt/orpheus/agents/orpheus-agent-video-motion
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/orpheus/agents/orpheus-agent-video-motion/src"
# No ORPHEUS_CONFIG_PATH: it outranks the search list, so pinning it here made
# this agent read /etc/orpheus/orpheus.yaml while the other components read
# /opt/orpheus/config/orpheus.yaml — one box, two configs.
EnvironmentFile=-/opt/orpheus/config/.env
ExecStart=/opt/orpheus/agents/orpheus-agent-video-motion/venv/bin/python -m orpheus_agent_video_motion.main
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Log bounds. systemd's default is 10000 messages per 30s per service — enough
# for one stuck agent to emit gigabytes a day into the journal and, on Ubuntu,
# into rsyslog's unbounded /var/log/syslog mirror. 500/30s is ~100x this
# station's busiest agent in normal operation and still passes a crash-loop
# traceback or a noisy model load intact. When the limit engages journald
# records "Suppressed N messages from <unit>", so a flood is visible as a
# flood rather than silently truncated.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
# Name ourselves in syslog: without this our agents appear as "python" and an
# operator cannot tell which one is flooding.
SyslogIdentifier=orpheus-agent-video-motion

[Install]
WantedBy=multi-user.target
