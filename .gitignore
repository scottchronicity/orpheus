# Data directories (runtime generated)
data/
output/
recordings/

# Exception: packaged source data (ships in the wheel), NOT runtime data.
!platform/orpheus-common/src/orpheus_common/detection/data/
!platform/orpheus-common/src/orpheus_common/detection/data/*.yaml

# Exception: bundled, committed data files (taxonomies, ontologies, etc.)
# that ship inside an agent's source tree.
!agents/*/src/*/data/
!agents/*/src/*/data/**

# Model checkpoints (use Git LFS for permanent models)
checkpoints/
*.ckpt

