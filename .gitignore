.pytype/

# Cython debug symbols
cython_debug/

# Claude Code agent tooling (the flywheel pipeline): TRACK the shared skills +
# agents + the generated repo map + the committed hooks — they're part of the
# repo's tooling — but ignore local/personal Claude state (settings.local.json,
# command history, etc.). The negations re-include the shared items; everything
# else directly under .claude stays ignored.
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/hooks/
!.claude/repo-map.md

