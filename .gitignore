lib/
# But DO track the frontend source's lib directory (Python build-artifact
# rule above shouldn't apply to TypeScript). Otherwise new files in
# services/orpheus_ui/frontend/src/lib/ get silently ignored.
!services/orpheus_ui/frontend/src/lib/
!services/orpheus_ui/frontend/src/lib/**
# bats libraries bootstrapped by `make test-bash` (pinned shallow clones,
# deliberately NOT submodules). Already covered by the `lib/` rule above; kept
# explicit so a future scoping of that rule can't silently start tracking
# three vendored repos.
tests/bats/lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

