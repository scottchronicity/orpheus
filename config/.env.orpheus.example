# macOS / local development overrides
# ------------------------------------
# Copy to config/.env.orpheus (gitignored) and adjust to taste.
# These override the canonical orpheus.example.yaml via OrpheusConfig.
#
# Usage:
#   cp config/.env.orpheus.example config/.env.orpheus
#   $EDITOR config/.env.orpheus
#   make dev-stack

# Storage path (no /data partition on Mac)
ORPHEUS_DATA_ROOT=$HOME/data/orpheus
ORPHEUS_STORAGE__BASE_PATH=$HOME/data/orpheus

# Replace the four-channel Behringer layout with a single laptop mic.
# Must be single-line JSON — multiline breaks shell env parsing.
ORPHEUS_AUDIO__CHANNELS='[{"id": 1, "name": "Laptop Mic", "enabled": true, "detection": {"algorithm": "adaptive_threshold", "threshold_db": -20.0, "margin_db": 15.0, "holdoff_seconds": 2.0}}]'

# Uncomment if your Mac mic can't do 48 kHz:
#ORPHEUS_AUDIO__SAMPLE_RATE=44100
