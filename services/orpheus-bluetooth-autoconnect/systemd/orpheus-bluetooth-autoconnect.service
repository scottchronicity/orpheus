[Unit]
Description=Orpheus Bluetooth Auto-Connect Service
Documentation=https://github.com/scottchronicity/orpheus
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
# Run as root (required for bluetoothctl operations)
User=root
Group=root

# Execute the connection script. It supervises the speaker itself (polling,
# reconnecting, exponential backoff while the speaker, controller or audio
# server is unavailable) and survives bluetooth.service restarts, so systemd
# only has to restart it if the script itself dies.
ExecStart=/usr/local/bin/orpheus-bluetooth-connect

# Restart whenever the script exits, without a start limit: a transient crash
# loop must never leave the speaker unsupervised until someone notices. Exit
# 78 (EX_CONFIG: invalid MAC or timing values) is not retried; the unit shows
# as failed and the journal names the bad setting.
Restart=always
RestartSec=30s
RestartPreventExitStatus=78

# Logging
StandardOutput=journal
StandardError=journal

# Log bounds. systemd's default is 10000 messages per 30s per service — enough
# for one stuck agent to emit gigabytes a day into the journal and, on Ubuntu,
# into rsyslog's unbounded /var/log/syslog mirror. 500/30s is ~100x this
# station's busiest agent in normal operation and still passes a crash-loop
# traceback or a noisy model load intact. When the limit engages journald
# records "Suppressed N messages from <unit>", so a flood is visible as a
# flood rather than silently truncated.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
SyslogIdentifier=orpheus-bluetooth

# Resource limits. The script and one bluetoothctl call need under 10 MB;
# 64 MB leaves headroom. (Interactive-mode bluetoothctl once reached this
# limit by re-reading an unbounded history file — see the script header.)
MemoryMax=64M

# Limit CPU usage to 10% (prevents runaway processes)
CPUQuota=10%

# Limit number of tasks (processes/threads)
TasksMax=10

[Install]
WantedBy=multi-user.target
