# Orpheus Dashboard - Camera Configuration
# 
# SETUP INSTRUCTIONS:
# - Development: Copy this to .env in project root
# - Production: Installed to /etc/orpheus/dashboard/cameras.env by install script
#
# All cameras use the same credentials (configured per-camera in web UI)

# Camera credentials
CAMERA_USER=orpheus
CAMERA_PASS=changeme

# Camera 1
CAMERA_1_TYPE=amcrest
CAMERA_1_NAME=orpheus-eye-1
CAMERA_1_HOST=orpheus-eye-1.example
CAMERA_1_MODEL=IP5M-B1186EW-AI-V3

# Camera 2
CAMERA_2_TYPE=amcrest
CAMERA_2_NAME=orpheus-eye-2
CAMERA_2_HOST=orpheus-eye-2.example
CAMERA_2_MODEL=IP5M-B1186EW-AI-V3

# Camera 3
CAMERA_3_TYPE=amcrest
CAMERA_3_NAME=orpheus-eye-3
CAMERA_3_HOST=orpheus-eye-3.example
CAMERA_3_MODEL=IP5M-B1186EW-AI-V3

# Camera 4
CAMERA_4_TYPE=amcrest
CAMERA_4_NAME=orpheus-eye-4
CAMERA_4_HOST=orpheus-eye-4.example
CAMERA_4_MODEL=IP5M-B1186EW-AI-V3

# Add more cameras as needed (supports up to CAMERA_10_*)
