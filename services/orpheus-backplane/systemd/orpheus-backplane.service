[Unit]
Description=Orpheus Messaging Backplane (NATS + JetStream)
Documentation=https://github.com/scottchronicity/orpheus
After=network.target time-sync.target
Wants=network.target

[Service]
Type=simple
User=orpheus
Group=orpheus

# store_dir in nats.conf reads this; keeps JetStream on disk under the shared root.
Environment=ORPHEUS_BACKPLANE_STORE=/var/lib/orpheus/backplane/jetstream
ExecStart=/usr/local/bin/nats-server -c /etc/orpheus/backplane/nats.conf

Restart=always
RestartSec=5s

# Security hardening (mirrors the mosquitto unit).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/orpheus/backplane/
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateTmp=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# JetStream needs a bit more than mosquitto; the file-store cap (nats.conf) is the
# real bound. RAM stays small because streams are file-backed, not memory.
# MemoryHigh throttles (reclaims) before MemoryMax hard-kills, so a load spike
# doesn't OOM-kill the whole backplane and flap every agent's pub/sub.
MemoryHigh=384M
MemoryMax=512M
CPUQuota=60%
TasksMax=128

StandardOutput=journal
StandardError=journal

# Log bounds. systemd's default is 10000 messages per 30s per service — enough
# for one stuck agent to emit gigabytes a day into the journal and, on Ubuntu,
# into rsyslog's unbounded /var/log/syslog mirror. 500/30s is ~100x this
# station's busiest agent in normal operation and still passes a crash-loop
# traceback or a noisy model load intact. When the limit engages journald
# records "Suppressed N messages from <unit>", so a flood is visible as a
# flood rather than silently truncated.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
SyslogIdentifier=orpheus-backplane

[Install]
WantedBy=multi-user.target
# Back-compat: agents that still say After=/Wants=orpheus-mqtt.service keep
# resolving during/after the rename (this creates the alias symlink on enable).
Alias=orpheus-mqtt.service
