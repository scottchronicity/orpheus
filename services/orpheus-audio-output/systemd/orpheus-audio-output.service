[Unit]
Description=Orpheus Audio Output Manager (output device, audio server, reconnect)
Documentation=https://github.com/scottchronicity/orpheus
# BlueZ for the Bluetooth output; logind (user runtime directories) for the
# PulseAudio server's socket; the broker only for health reporting (optional).
After=time-sync.target bluetooth.service dbus.service systemd-logind.service systemd-user-sessions.service orpheus-backplane.service
Wants=bluetooth.service
# Replaces the retired supervisor; never run both.
Conflicts=orpheus-bluetooth-autoconnect.service

[Service]
Type=simple
# Root: BlueZ connect/trust and starting the audio server as its configured
# user. The PulseAudio it manages runs as audio_output.server.pulseaudio.user
# inside this unit's cgroup, so stopping the unit stops it.
User=root
Group=root
WorkingDirectory=/opt/orpheus/services/orpheus-audio-output
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/orpheus/services/orpheus-audio-output/src
EnvironmentFile=-/opt/orpheus/config/.env
RuntimeDirectory=orpheus-audio-output
RuntimeDirectoryMode=0755
ExecStart=/opt/orpheus/services/orpheus-audio-output/venv/bin/python -m orpheus_audio_output.main
# Restart on crashes. A clean exit (audio_output disabled) stays stopped, and
# exit 78 (invalid configuration) is not retried: the journal names the setting.
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
TimeoutStopSec=30
KillMode=control-group

StandardOutput=journal
StandardError=journal
# Log bounds. systemd's default is 10000 messages per 30s per service — enough
# for one stuck agent to emit gigabytes a day into the journal and, on Ubuntu,
# into rsyslog's unbounded /var/log/syslog mirror. 500/30s is ~100x this
# station's busiest agent in normal operation and still passes a crash-loop
# traceback or a noisy model load intact. When the limit engages journald
# records "Suppressed N messages from <unit>", so a flood is visible as a
# flood rather than silently truncated.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
SyslogIdentifier=orpheus-audio-output

# The manager (~60 MB) plus a Bluetooth-only PulseAudio (~20 MB).
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
