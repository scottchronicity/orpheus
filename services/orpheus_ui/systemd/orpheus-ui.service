# THE unit that gets installed. systemd/install-service.sh copies this file
# (substituting the install prefix); it does not generate its own. A generated
# copy drifted from this one for months — it never picked up EnvironmentFile=,
# so /opt/orpheus/config/.env (the per-host backbone URL and the seeded
# passwords) never reached the service, and nothing could catch it because this
# file was never installed anywhere.
[Unit]
Description=Orpheus UI Web Service
After=network.target time-sync.target
Documentation=https://github.com/scottchronicity/orpheus

[Service]
Type=simple
User=orpheus
Group=orpheus
WorkingDirectory=/opt/orpheus/ui
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/opt/orpheus/ui/.node/bin:/opt/orpheus/ui/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/opt/orpheus/ui/src"
Environment="ORPHEUS_UI_DATABASE_URL=sqlite+aiosqlite:////data/orpheus/users.db"
# No ORPHEUS_CONFIG_PATH: it outranks the search list, so pinning it here made
# the UI read /etc/orpheus/orpheus.yaml while the other components read
# /opt/orpheus/config/orpheus.yaml — every runbook edits the /opt copy, so
# every ui.* and dashboard.* flag flip was a no-op.
EnvironmentFile=-/opt/orpheus/config/.env
# --no-access-log: uvicorn's access log writes the full request line, and media
# elements authenticate with the session JWT in the query string. Default-on,
# that puts a 24h-valid, unrevocable token into the journal, where a log ship
# or a support bundle carries it off the box.
ExecStart=/opt/orpheus/ui/venv/bin/uvicorn orpheus_ui.main:app --host 0.0.0.0 --port 8082 --no-access-log
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

# Log bounds. systemd's default is 10000 messages per 30s per service — enough
# for one stuck agent to emit gigabytes a day into the journal and, on Ubuntu,
# into rsyslog's unbounded /var/log/syslog mirror. 500/30s is ~100x this
# station's busiest agent in normal operation and still passes a crash-loop
# traceback or a noisy model load intact. When the limit engages journald
# records "Suppressed N messages from <unit>", so a flood is visible as a
# flood rather than silently truncated.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
SyslogIdentifier=orpheus-ui

[Install]
WantedBy=multi-user.target
