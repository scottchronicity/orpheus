# Copy this file to .env and fill in the values for local development.
# Run: cp .env.example .env

# Secret key for signing JWT tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random secret is generated at startup (sessions won't survive restarts).
ORPHEUS_UI_JWT_SECRET=change-me-in-production

# JWT token lifetime in seconds (default: 86400 = 24 hours)
# ORPHEUS_UI_JWT_LIFETIME=86400
